{
	"Version": "2012-10-17",
	"Statement": [
		{
			"Sid": "S3VectorsRead",
			"Effect": "Allow",
			"Action": [
				"s3vectors:ListIndexes",
				"s3vectors:ListTagsForResource",
				"s3vectors:ListVectorBuckets",
				"s3vectors:GetIndex",
				"s3vectors:GetVectorBucket",
				"s3vectors:GetVectorBucketPolicy",
				"s3vectors:QueryVectors",
				"s3vectors:GetVectors"
			],
			"Resource": "*"
		},
		{
			"Sid": "S3VectorsWrite",
			"Effect": "Allow",
			"Action": [
				"s3vectors:PutVectors",
				"s3vectors:DeleteVectors",
				"s3vectors:ListVectors"
			],
			"Resource": [
				"arn:aws:s3vectors:{region_name}:{account_id}:bucket/coffee-products-tutorial",
				"arn:aws:s3vectors:{region_name}:{account_id}:bucket/coffee-products-tutorial/*",
				"arn:aws:s3vectors:{region_name}:{account_id}:bucket/coffee-products-tutorial/index/idx-coffee-products",
				"arn:aws:s3vectors:{region_name}:{account_id}:bucket/coffee-products-tutorial/index/idx-coffee-products/*"
			]
		},
		{
			"Sid": "S3Access",
			"Effect": "Allow",
			"Action": [
				"s3:GetObject",
				"s3:PutObject",
				"s3:DeleteObject",
				"s3:ListBucket"
			],
			"Resource": [
				"arn:aws:s3:::coffee-products-tutorial-full-data",
				"arn:aws:s3:::coffee-products-tutorial-full-data/*"
			]
		}
	]
}